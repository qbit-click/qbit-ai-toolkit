# Optional Context7 API key. Codex reads it only from the process environment.
CONTEXT7_API_KEY=

# Optional Sentry scope hints for human incident analysis; Sentry MCP uses OAuth.
SENTRY_ORG=
SENTRY_PROJECT=

# Comma-separated local or explicitly approved test origins allowed by the Playwright wrapper.
AI_ALLOWED_TEST_ORIGINS={{ALLOWED_ORIGINS_CSV}}

# Optional comma-separated repository-relative paths approved for Playwright upload commands.
AI_APPROVED_UPLOAD_ROOTS=
