{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qbit.dev/schemas/asset.schema.json",
  "title": "Qbit Toolkit Asset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "version",
    "path",
    "consumers",
    "status",
    "description"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "installer",
        "prompt",
        "docker-compose-template",
        "dockerfile-template",
        "repository-template",
        "ci-template",
        "agent-skill",
        "agent-policy",
        "script"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "cli",
          "console",
          "shared"
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "experimental",
        "preview",
        "stable",
        "deprecated"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "minimumConsumerVersions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "supportedPlatforms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "windows",
          "linux",
          "macos"
        ]
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": true
    },
    "release": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
